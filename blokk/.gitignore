# runtime state — the database IS the system; back it up, don't commit it
*.db
*.db-wal
*.db-shm
blokk.db*

# machine-local config and secrets
blokk.conf
.blokk-token
.env
.env.*
secrets/
*.pem
*.key

# offloaded activity results
/tmp/blokk/
*.local.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# os
.DS_Store

# local model weights — gigabytes, and not ours to version
models/*.gguf
models/*.bin
models/*.safetensors
