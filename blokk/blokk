#!/usr/bin/env bash
# Blokk. One command.
#
#   ./blokk            set up if needed, then run
#   ./blokk 8080       on a different port
#
# Unconfigured, it opens the setup wizard in your browser. Configured, it
# starts the model servers and the app. Same command either way — you should
# not have to know which state you are in.
set -euo pipefail
cd "$(dirname "$0")"
PORT="${1:-8080}"

[ -f blokk.db ] || { echo "First run — seeding..."; python3 seed.py; }

if [ ! -f blokk.conf ]; then
  echo ""
  echo "  No configuration yet — opening the setup wizard."
  echo "  http://localhost:${PORT}"
  echo ""
  ( sleep 1.5; command -v open >/dev/null 2>&1 && open "http://localhost:${PORT}" ) &
  exec python3 -m api.server "$PORT"
fi

exec ./run.sh "$PORT"
