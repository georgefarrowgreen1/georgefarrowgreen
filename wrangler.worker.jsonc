// InFlite's apps on Cloudflare Workers. See .tools/workers/README.md.
// Built by .tools/workers/build.mjs; deployed on pushes to main and by workflow_dispatch.
{
  "$schema": ".tools/tests/node_modules/wrangler/config-schema.json",
  "name": "inflite-apps",
  "main": ".tools/workers/dist/index.js",
  "compatibility_date": "2026-06-17",
  // Static assets follow the middleware; HTML, 404.html, _headers and _redirects are handled by Workers.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [{ "binding": "BIO_KV", "id": "10ec6d961a224b3a8b68a7c993ca0caf" }],
  "r2_buckets": [{ "binding": "BIO_R2", "bucket_name": "bio-media" }, { "binding": "FILES_R2", "bucket_name": "inflite-private-files" }],
  "d1_databases": [{ "binding": "DB", "database_name": "bio-db", "database_id": "de4ad515-52c6-4cb3-9f8f-008384ef813a" }],
  "durable_objects": { "bindings": [{ "name": "TYPING", "class_name": "Typing", "script_name": "georgefarrowgreen-live" }] },
  // (direct links to InFlite's other Workers, Mail's and Today's, for this one's own requests to them: functions/_sites.js
  // siteFetch; and the home page's, gfg, for status.inflite.ai's check of it from inside: functions/_status.js)
  "services": [{ "binding": "ROUTING_APP", "service": "inflite-routing", "entrypoint": "RoutingService" }, { "binding": "MAIL_APP", "service": "inflite-email" }, { "binding": "TODAY_APP", "service": "inflite" }, { "binding": "GFG_APP", "service": "gfg" }],
  // (the everyday ceilings, counted where Cloudflare serves each request rather than in the database: each so many a
  // minute for each key, functions/_pigeon.js pace)
  "ratelimits": [{ "name": "RL10", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } }, { "name": "RL20", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }, { "name": "RL40", "namespace_id": "4103", "simple": { "limit": 40, "period": 60 } }, { "name": "RL80", "namespace_id": "4104", "simple": { "limit": 80, "period": 60 } }, { "name": "RL160", "namespace_id": "4105", "simple": { "limit": 160, "period": 60 } }, { "name": "RL320", "namespace_id": "4106", "simple": { "limit": 320, "period": 60 } }],
  "observability": { "enabled": true },
  // Scheduled jobs use this Worker address, past the custom domains' bot checks.
  "workers_dev": true,
  "vars": {
    "TICK_HOST": "inflite-apps.georgefarrowgreen.workers.dev",
    "HUB_ORIGINS": "https://inflite.ai,https://next.inflite.ai,https://os.inflite.ai"
  },
  // Custom domains, each with its own DNS record.
  "routes": [
    { "pattern": "finance.inflite.ai", "custom_domain": true },
    { "pattern": "fitness.inflite.ai", "custom_domain": true },
    { "pattern": "weather.inflite.ai", "custom_domain": true },
    { "pattern": "account.inflite.ai", "custom_domain": true },
    { "pattern": "auth.inflite.ai", "custom_domain": true },
    { "pattern": "chat.inflite.ai", "custom_domain": true },
    // (InFlite's status page: functions/_status.js)
    { "pattern": "status.inflite.ai", "custom_domain": true }
  ]

}
