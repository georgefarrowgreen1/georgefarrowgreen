// InFlite's apps as a Worker with static assets (the move off Pages: .tools/workers/README.md): chat., weather.,
// fitness., finance., account., auth. and status.inflite.ai. Its twin, "gfg" (wrangler.gfg.jsonc), is the same build for
// georgefarrowgreen.com's own addresses; the site decides what each address is, as it does on Pages. Not live: the site
// is still the Pages project (wrangler.toml) until the addresses are moved over. Until then this deploys, by hand only
// (.github/workflows/worker-deploy.yml), with no routes, so it's reachable only at its workers.dev address, side by
// side with Pages, on the same database, storage and keys.
//   node .tools/workers/build.mjs                     the functions/ folder compiled into one Worker (as Pages does)
//   npx wrangler deploy -c wrangler.worker.jsonc      (or the workflow)
{
  "$schema": ".tools/tests/node_modules/wrangler/config-schema.json",
  "name": "inflite-apps",
  "main": ".tools/workers/dist/index.js",
  "compatibility_date": "2026-06-17",
  // (the site's files, as Pages served them: every request through the Worker first, as functions/_middleware.js
  // sees everything on Pages; what it passes on (ctx.next()) is the files', with Pages' own ways with HTML, a 404.html
  // and _headers and _redirects. What's never the site's is left out: .assetsignore)
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [{ "binding": "BIO_KV", "id": "10ec6d961a224b3a8b68a7c993ca0caf" }],
  "r2_buckets": [{ "binding": "BIO_R2", "bucket_name": "bio-media" }],
  "d1_databases": [{ "binding": "DB", "database_name": "bio-db", "database_id": "de4ad515-52c6-4cb3-9f8f-008384ef813a" }],
  "durable_objects": { "bindings": [{ "name": "TYPING", "class_name": "Typing", "script_name": "georgefarrowgreen-live" }] },
  // (direct links to InFlite's other Workers, Mail's and Today's, for this one's own requests to them: functions/_sites.js
  // siteFetch; and the home page's, gfg, for status.inflite.ai's check of it from inside: functions/_status.js)
  "services": [{ "binding": "MAIL_APP", "service": "inflite-email" }, { "binding": "TODAY_APP", "service": "inflite" }, { "binding": "GFG_APP", "service": "gfg" }],
  "observability": { "enabled": true },
  // (its workers.dev address: what the scheduled jobs call once it's live, past the custom domains' bot checks, as
  // they call georgefarrowgreen.pages.dev now: functions/_sites.js tickHost)
  "workers_dev": true,
  "vars": { "TICK_HOST": "inflite-apps.georgefarrowgreen.workers.dev" },
  // (its addresses, each its own custom domain, with its own DNS record, since the Pages project and the records it had
  // made are gone)
  "routes": [
    { "pattern": "finance.inflite.ai", "custom_domain": true },
    { "pattern": "fitness.inflite.ai", "custom_domain": true },
    { "pattern": "weather.inflite.ai", "custom_domain": true },
    { "pattern": "account.inflite.ai", "custom_domain": true },
    { "pattern": "auth.inflite.ai", "custom_domain": true },
    { "pattern": "chat.inflite.ai", "custom_domain": true },
    // (InFlite's status page: functions/_status.js)
    { "pattern": "status.inflite.ai", "custom_domain": true }
  ]
  // Its addresses go here at the move, one at a time, each a route in front of the Pages project's (README, step 5):
  // "routes": [
  //   { "pattern": "finance.inflite.ai/*", "zone_name": "inflite.ai" }, { "pattern": "fitness.inflite.ai/*", "zone_name": "inflite.ai" },
  //   { "pattern": "weather.inflite.ai/*", "zone_name": "inflite.ai" }, { "pattern": "account.inflite.ai/*", "zone_name": "inflite.ai" },
  //   { "pattern": "auth.inflite.ai/*", "zone_name": "inflite.ai" }, { "pattern": "chat.inflite.ai/*", "zone_name": "inflite.ai" }
  // ]
}
