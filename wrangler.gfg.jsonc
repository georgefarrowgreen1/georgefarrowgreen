// georgefarrowgreen.com and Fit Studio on Cloudflare Workers. See .tools/workers/README.md.
// Built by .tools/workers/build.mjs; deployed on pushes to main and by workflow_dispatch.
{
  "$schema": ".tools/tests/node_modules/wrangler/config-schema.json",
  "name": "gfg",
  "main": ".tools/workers/dist/index.js",
  "compatibility_date": "2026-06-17",
  // Static assets follow the middleware; HTML, 404.html, _headers and _redirects are handled by Workers.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [{ "binding": "BIO_KV", "id": "10ec6d961a224b3a8b68a7c993ca0caf" }],
  "r2_buckets": [{ "binding": "BIO_R2", "bucket_name": "bio-media" }],
  "d1_databases": [{ "binding": "DB", "database_name": "bio-db", "database_id": "de4ad515-52c6-4cb3-9f8f-008384ef813a" }],
  "durable_objects": { "bindings": [{ "name": "TYPING", "class_name": "Typing", "script_name": "georgefarrowgreen-live" }] },
  // (direct links to InFlite's other Workers, Mail's and Today's, for this one's own requests to them: functions/_sites.js
  // siteFetch)
  "services": [{ "binding": "ROUTING_APP", "service": "inflite-routing", "entrypoint": "RoutingService" }, { "binding": "MAIL_APP", "service": "inflite-email" }, { "binding": "TODAY_APP", "service": "inflite" }],
  "observability": { "enabled": true },
  // (its workers.dev address, for looking at it before the move; the scheduled jobs call inflite-apps)
  "workers_dev": true,
  "vars": { "HUB_ORIGINS": "https://inflite.ai,https://next.inflite.ai,https://os.inflite.ai" },
  // Custom domains.
  "routes": [
    // (www had no address of its own before: a custom domain gives it one, and it goes on to georgefarrowgreen.com)
    { "pattern": "www.georgefarrowgreen.com", "custom_domain": true },
    { "pattern": "account.georgefarrowgreen.com", "custom_domain": true },
    { "pattern": "chat.georgefarrowgreen.com", "custom_domain": true },
    { "pattern": "fitness.georgefarrowgreen.com", "custom_domain": true },
    { "pattern": "weather.georgefarrowgreen.com", "custom_domain": true },
    { "pattern": "fitting.georgefarrowgreen.com", "custom_domain": true },
    { "pattern": "georgefarrowgreen.com", "custom_domain": true }
  ]

}
