{
  "name": "Your inflite.ai account",
  "short_name": "Account",
  "description": "One sign-in for every app on inflite.ai: your profile, password, passkeys and devices.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1024",
  "theme_color": "#1b2860",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-180.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
